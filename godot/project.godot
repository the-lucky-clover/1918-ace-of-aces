; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="1918"
config/description="WWI top-down shoot-em-up in the spirit of Capcom's 194x. Working title — final release title pending."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/bg_color=Color(0.02, 0.02, 0.03, 1)

[autoload]

Global="*res://scripts/global.gd"
Sorties="*res://scripts/sortie_data.gd"
FX="*res://scripts/effects.gd"
Music="*res://scripts/music.gd"
SFX="*res://scripts/sfx.gd"
IAPs="*res://scripts/iaps.gd"
Ads="*res://scripts/ads.gd"

[display]

window/size/viewport_width=720
window/size/viewport_height=1280
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"
window/handheld/orientation=1

[input_devices]

pointing/emulate_touch_from_mouse=true

