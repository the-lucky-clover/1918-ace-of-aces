# Boss entry convention (v17, kept): top-center of the frame, North on
# the minimap, diving to y=300. Arena bosses duel in the seamless
# blue-sky cyclical arena; the ground war stands down for the duel.
const BOSS_ENTRY_REGION := "top-center"
const BOSS_ENTRY_QUADRANT := "N"
const BLUESKY_BOSSES: Array = [4, 27, 28, 29, 30, 31]
# Fighter-wave aircraft that count as the enemy squadron for
# shoot-down goals (1942-style: the duel in the sky).
const SQUADRON_TYPES: Array = ["e1_eindecker", "e2_albatros_d3",
	"e3_albatros_d5", "e4_fokker_dr1", "e5_rumpler"]

## Nominal squadron strength: total fighter-wave aircraft in the sortie.
static func squadron_strength(sortie: Dictionary) -> int:
	var n := 0
	for w in sortie["waves"]:
		if String(w["type"]) in SQUADRON_TYPES:
			n += int(w["count"])
	return n

## Break-point goal: an attainable ~55% of the squadron.
static func squadron_goal(sortie: Dictionary) -> int:
	return int(ceil(squadron_strength(sortie) * 0.55))

## Squadron-break bonus, escalating by sortie index.
static func squadron_bonus(sortie_index: int) -> int:
	return 400 + 100 * sortie_index

static func boss_hp_for(tier: int) -> int:
	return int(round(900.0 * float(tier) / 60.0))

## Secondary objective text/bonus from the palette.
static func secondary_text(sec: Dictionary) -> String:
	var def: Dictionary = SECONDARY_DEFS[sec["id"]]
	var text: String = def["text"]
	if "%d" in text:
		return text % int(sec["target"])
	return text

static func secondary_bonus(sec_id: String) -> int:
	return int(SECONDARY_DEFS[sec_id]["bonus"])

